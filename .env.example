# Copy to .env (gitignored) and fill in. Real environment variables win over this file.

# Enables Pass 2. Without it vouch still runs Pass 1 and says why Pass 2 was skipped.
# Create one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Where run history lives. Default: $XDG_DATA_HOME/vouch/runs.db
# Setting this also makes the CLI record runs without --save.
# VOUCH_DB=./runs.db

# The repo the API reviews. Default: the server's working directory.
# VOUCH_REPO_ROOT=/path/to/repo
